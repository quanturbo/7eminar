# Copy to .env for local live-LLM runs. Do not commit real secrets.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
KNOWLEDGE_BASE_PATH=knowledge_base.md
TRACE_PATH=traces.jsonl
RETRIEVAL_TOP_K=4
MIN_RETRIEVAL_SCORE=0.08
MIN_VECTOR_ONLY_SCORE=0.35
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=256
RETRIEVAL_CANDIDATE_POOL_SIZE=64
RETRIEVAL_BM25_WEIGHT=0.35
RETRIEVAL_VECTOR_WEIGHT=0.65
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_DIR=.cache/retrieval
LANGSMITH_TRACING=false
